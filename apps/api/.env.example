# Vendeur IA - API Environment Variables

# Node Environment
NODE_ENV=production

# Server Port
PORT=3001

# MongoDB Connection String
MONGODB_URI=mongodb+srv://...

# Redis Connection String
REDIS_URL=redis://...

# Secret key for JWT signing
JWT_SECRET=your_super_secret_jwt_key

# Client URL (for CORS and Paystack callbacks)
CLIENT_URL=https://vendeur-ia.vercel.app

# AI Brain
GEMINI_API_KEY=
OPENAI_API_KEY=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vendeur IA - API Environment Variables

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=3001

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/vendeur-ia

# Secret key for JWT signing
JWT_SECRET=your_super_secret_jwt_key_change_me

# WhatsApp Meta API (Optional for demo/manual mode)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# Paystack (Optional for demo)
PAYSTACK_SECRET_KEY=

# AI Brain (Optional for mock mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client URL (for CORS and Paystack callbacks)
CLIENT_URL=http://localhost:5173
